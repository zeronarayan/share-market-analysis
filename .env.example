# Supabase Configuration
VITE_SUPABASE_URL=your_supabase_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Backend Configuration
BACKEND_URL=http://localhost:5000

# API Keys
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key
